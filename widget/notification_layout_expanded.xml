<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notif_expanded_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/notif_exp_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="☀️"
            android:textSize="26sp"
            android:layout_marginEnd="10dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notif_exp_city"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="بندرعباس"
                android:textColor="#1E2A4A"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/notif_exp_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="—"
                android:textColor="#1E2A4A"
                android:textSize="11sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/notif_exp_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="—"
            android:textColor="#1E2A4A"
            android:textSize="22sp"
            android:textStyle="bold" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#33000000"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp" />

    <TextView
        android:id="@+id/notif_exp_tide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌊 —"
        android:textColor="#1E2A4A"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_exp_wind"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💨 —"
            android:textColor="#1E2A4A"
            android:textSize="12sp"
            android:layout_marginEnd="14dp" />

        <TextView
            android:id="@+id/notif_exp_humidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💧 —"
            android:textColor="#1E2A4A"
            android:textSize="12sp" />

    </LinearLayout>

</LinearLayout>
