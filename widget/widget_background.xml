<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <gradient
                android:startColor="#FF6C3CE0"
                android:centerColor="#FF4A5FD9"
                android:endColor="#FF1E3A8C"
                android:angle="135" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="32dp" />
            <stroke
                android:width="1.5dp"
                android:color="#40FFFFFF" />
        </shape>
    </item>
    <item android:gravity="top|left" android:width="120dp" android:height="70dp">
        <shape android:shape="oval">
            <solid android:color="#26FFFFFF" />
        </shape>
    </item>
    <item android:gravity="bottom|right" android:width="90dp" android:height="50dp">
        <shape android:shape="oval">
            <solid android:color="#14000000" />
        </shape>
    </item>
</layer-list>
