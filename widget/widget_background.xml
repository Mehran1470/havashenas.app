<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="26dp" />
            <gradient
                android:startColor="#E6141B32"
                android:centerColor="#E61C2B4F"
                android:endColor="#E60A1628"
                android:angle="135" />
            <stroke
                android:width="1dp"
                android:color="#3D6FA8FF" />
        </shape>
    </item>
    <item android:gravity="top|left" android:width="80dp" android:height="40dp">
        <shape android:shape="oval">
            <solid android:color="#1A4FA8FF" />
        </shape>
    </item>
    <item android:gravity="bottom|right" android:width="50dp" android:height="25dp">
        <shape android:shape="oval">
            <solid android:color="#0DFFFFFF" />
        </shape>
    </item>
</layer-list>
